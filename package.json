{
  "name": "cutsync-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start:web",
    "start:web": "npm --workspace @cutsync/web run start",
    "start:client": "npm --workspace @cutsync/client run start",
    "start:business": "npm --workspace @cutsync/business run start",
    "start:control": "npm --workspace @cutsync/control run start",
    "web": "npm --workspace @cutsync/web run web",
    "android:client": "npm --workspace @cutsync/client run android",
    "ios:client": "npm --workspace @cutsync/client run ios",
    "android:business": "npm --workspace @cutsync/business run android",
    "ios:business": "npm --workspace @cutsync/business run ios",
    "eas:client:development": "npm --workspace @cutsync/client run eas:development",
    "eas:client:preview": "npm --workspace @cutsync/client run eas:preview",
    "eas:client:production": "npm --workspace @cutsync/client run eas:production",
    "eas:client:builds": "npm --workspace @cutsync/client run eas:builds",
    "eas:business:development": "npm --workspace @cutsync/business run eas:development",
    "eas:business:preview": "npm --workspace @cutsync/business run eas:preview",
    "eas:business:production": "npm --workspace @cutsync/business run eas:production",
    "eas:business:builds": "npm --workspace @cutsync/business run eas:builds",
    "validate:mobile:environments": "npm --workspace @cutsync/client run env:validate:development && npm --workspace @cutsync/client run env:validate:preview && npm --workspace @cutsync/client run env:validate:production && npm --workspace @cutsync/business run env:validate:development && npm --workspace @cutsync/business run env:validate:preview && npm --workspace @cutsync/business run env:validate:production",
    "test:mobile:environment": "playwright test --project=unit tests/unit/mobile-environment-contract.unit.spec.ts",
    "test:phase1:real-jwt": "node scripts/validate-phase1-real-jwt.mjs",
    "test:phase2:real-jwt": "node scripts/validate-phase2-real-jwt.mjs",
    "test:g14:homolog": "node scripts/validate-gate-g14-homolog.mjs",
    "build:web": "npm --workspace @cutsync/web run build:web",
    "build:control": "npm --workspace @cutsync/control run build:web",
    "serve:test": "npm run build:web && npm --workspace @cutsync/web run serve:test",
    "test:e2e": "playwright test",
    "test:e2e:client": "playwright test --config=playwright.client.config.ts",
    "test:e2e:control": "playwright test --config=playwright.control.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck:shared": "tsc --noEmit -p packages/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:client": "tsc --noEmit -p apps/client/tsconfig.json",
    "typecheck:business": "tsc --noEmit -p apps/business/tsconfig.json",
    "typecheck:control": "tsc --noEmit -p apps/control/tsconfig.json",
    "typecheck:new-apps": "npm run typecheck:shared && npm run typecheck:client && npm run typecheck:business && npm run typecheck:control",
    "lint": "npm run lint:web && npm run lint:client && npm run lint:business && npm run lint:control",
    "lint:web": "npm --workspace @cutsync/web run lint",
    "lint:client": "npm --workspace @cutsync/client run lint",
    "lint:business": "npm --workspace @cutsync/business run lint",
    "lint:control": "npm --workspace @cutsync/control run lint",
    "types:supabase": "bash scripts/generate-supabase-types.sh",
    "check:supabase-schema": "bash scripts/check-supabase-schema.sh",
    "support:verify-jsm": "node --env-file=supabase/functions/.env.support.local scripts/verify-jsm-support.mjs",
    "tauri:dev": "npm --workspace @cutsync/web run tauri:dev",
    "tauri:build": "npm --workspace @cutsync/web run tauri:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-screens": "4.26.0"
  },
  "engines": {
    "node": "22.x"
  }
}
