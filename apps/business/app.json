{
  "expo": {
    "name": "CutSync Business",
    "slug": "cutsync-business",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cutsync-business",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e7525fdb-a629-40b7-b1e3-b2d043a88fea"
    },
    "ios": {
      "bundleIdentifier": "com.cutsync.business",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cutsync.business",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "operations"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7525fdb-a629-40b7-b1e3-b2d043a88fea"
      }
    },
    "owner": "chernobruno"
  }
}
