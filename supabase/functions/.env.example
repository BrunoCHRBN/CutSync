# Public runtime location (server-side function environment)
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-secret

# Stripe Test Mode first. Live keys remain blocked until fiscal approval is recorded.
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_OWNER_MONTHLY_PRICE_ID=price_replace
# Graduated recurring Price: 1st R$49.90, 2nd R$44.90, 3rd-4th R$39.90.
STRIPE_ORGANIZATION_MONTHLY_PRICE_ID=price_replace
# Only configured after a negotiated network contract exists.
STRIPE_ORGANIZATION_NETWORK_PRICE_ID=price_replace
CUTSYNC_WEB_URL=http://localhost:8081

# Focus NFe homologation first.
FOCUS_NFE_TOKEN=replace-with-homologation-token
FOCUS_NFE_ENVIRONMENT=homologation

# Random server-only secret used by scheduled workers.
BILLING_JOB_SECRET=replace-with-random-server-secret

# Jira Service Management. Keep every value server-side.
JSM_BASE_URL=https://your-domain.atlassian.net
# Free portal customer used only to proxy authenticated CutSync requesters.
JSM_REQUESTER_EMAIL=cutsync-requester@example.com
JSM_REQUESTER_API_TOKEN=replace-with-requester-api-token
JSM_REQUESTER_ACCOUNT_ID=replace-with-requester-atlassian-account-id
# Jira agent used only for projection, SLA and routing. It must be a different account.
JSM_AGENT_EMAIL=cutsync-agent@example.com
JSM_AGENT_API_TOKEN=replace-with-agent-api-token
JSM_PROJECT_KEY=SUP
JSM_SERVICE_DESK_ID=1
JSM_REQUEST_TYPE_ID=1
JSM_FIELD_CUTSYNC_TICKET_ID=customfield_10000
JSM_FIELD_PRODUCT=customfield_10001
JSM_FIELD_AREA=customfield_10002
JSM_FIELD_REQUESTER_ROLE=customfield_10003
JSM_FIELD_CUTSYNC_TEAM=customfield_10004
JSM_FIELD_LOCATION=customfield_10005
JSM_FIELD_ESCALATION_LEVEL=customfield_10006
JSM_FIELD_ROUTING_VERSION=customfield_10007
JSM_FIELD_IMPACT=customfield_10008
JSM_FIELD_PRIORITY=customfield_10009
SUPPORT_JOB_SECRET=replace-with-separate-random-server-secret
